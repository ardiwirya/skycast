# Base URL for the Open-Meteo forecast API.
# Open-Meteo does not require an API key, so this only needs to change
# if you point the app at a different host (e.g. a paid plan or proxy).
VITE_WEATHER_API_BASE_URL=https://api.open-meteo.com/v1

# Base URL for the Open-Meteo geocoding API, used to resolve city search
# queries into coordinates.
VITE_GEOCODING_API_BASE_URL=https://geocoding-api.open-meteo.com/v1
